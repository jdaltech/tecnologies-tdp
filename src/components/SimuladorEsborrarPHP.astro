---
// src/components/SimuladorEsborrarPHP.astro
---

<div class="del-widget not-content">
  <div class="widget-header">
    <span class="badge">Laboratori interactiu · Validació isset() i DELETE</span>
    <h4>Com funciona <code>if (isset($_GET['id']))</code> dins <code>esborrar_tasca.php</code>?</h4>
    <p class="guide">
      1. Tria una de les URLs simulades de l'esquerra (una amb <code>?id=2</code> i una altra sense cap paràmetre). 
      2. Observa com el filtre <code>isset()</code> decideix si deixa passar l'execució cap a MySQL o bloqueja l'error.
    </p>
  </div>

  <div class="sim-grid">
    <!-- COLUMNA ESQUERRA: PROVES DE PETICIÓ + TAULA MYSQL -->
    <div class="panel">
      <div class="panel-head">1. Simula una petició al fitxer</div>
      <div class="btn-group">
        <button type="button" class="req-btn active" data-mode="valid">
          <span class="tag-ok">Amb dada</span>
          <code>esborrar_tasca.php?id=2</code>
        </button>
        <button type="button" class="req-btn" data-mode="empty">
          <span class="tag-warn">Sense dada</span>
          <code>esborrar_tasca.php</code>
        </button>
      </div>

      <div class="panel-head mt-small">Estat actual de la taula <code>tasques</code></div>
      <table class="mini-db">
        <thead>
          <tr>
            <th>id</th>
            <th>tasca</th>
            <th>Estat</th>
          </tr>
        </thead>
        <tbody id="del-db-body">
          <tr>
            <td><code>1</code></td>
            <td>Netejar el cotxe</td>
            <td><span class="st-keep">Es manté</span></td>
          </tr>
          <tr id="row-target-2" class="row-deleted">
            <td><code>2</code></td>
            <td>Fer exercici</td>
            <td><span class="st-del" id="st-row-2">Esborrada!</span></td>
          </tr>
          <tr>
            <td><code>3</code></td>
            <td>Comprar pa</td>
            <td><span class="st-keep">Es manté</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- COLUMNA DRETA: FLUX INTERN DINS esborrar_tasca.php -->
    <div class="panel">
      <div class="panel-head">2. Què passa dins <code>esborrar_tasca.php</code>?</div>

      <!-- PAS A: COMPROVACIÓ ISSET -->
      <div class="logic-card" id="box-isset">
        <div class="logic-top">
          <span class="step-num">PAS A · El porter <code>isset()</code></span>
          <span class="result-badge ok" id="isset-badge">TRUE (Existeix)</span>
        </div>
        <p class="logic-desc" id="isset-desc">
          La URL porta <code>?id=2</code>. Com que la variable <code>$_GET['id']</code> existeix i no és nul·la, PHP entra dins les claus <code>&#123; ... &#125;</code>.
        </p>
      </div>

      <!-- PAS B: CONSULTA SQL -->
      <div class="logic-card" id="box-sql">
        <div class="logic-top">
          <span class="step-num">PAS B · Consulta SQL executada</span>
        </div>
        <code class="sql-preview" id="del-sql-preview">DELETE FROM tasques WHERE id = 2</code>
        <p class="logic-desc" id="sql-desc">
          Gràcies a <code>WHERE id = 2</code>, MySQL només elimina aquesta fila i respecta la 1 i la 3.
        </p>
      </div>

      <!-- PAS C: REDIRECCIÓ -->
      <div class="logic-card redirect-card">
        <div class="logic-top">
          <span class="step-num">PAS C · Tornada automàtica</span>
        </div>
        <code class="hdr-preview">header("Location: index.php");</code>
        <p class="logic-desc">
          Tant si s'ha esborrat com si no, PHP retorna l'usuari a la pantalla principal perquè no vegi una pàgina en blanc.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function initEsborrarSim() {
    const reqBtns = document.querySelectorAll('.del-widget .req-btn');
    const issetBadge = document.getElementById('isset-badge');
    const issetDesc = document.getElementById('isset-desc');
    const boxSql = document.getElementById('box-sql');
    const sqlPreview = document.getElementById('del-sql-preview');
    const sqlDesc = document.getElementById('sql-desc');
    const row2 = document.getElementById('row-target-2');
    const stRow2 = document.getElementById('st-row-2');

    if (!issetBadge || !issetDesc || !boxSql || !sqlPreview || !sqlDesc || !row2 || !stRow2) return;

    reqBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        reqBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const mode = btn.getAttribute('data-mode');

        if (mode === 'valid') {
          issetBadge.textContent = 'TRUE (Existeix)';
          issetBadge.className = 'result-badge ok';
          issetDesc.innerHTML = 'La URL porta <code>?id=2</code>. Com que <code>$_GET[\'id\']</code> existeix, PHP entra dins del bloc <code>if</code>.';

          boxSql.classList.remove('skipped');
          sqlPreview.textContent = 'DELETE FROM tasques WHERE id = 2';
          sqlDesc.innerHTML = 'Gràcies a <code>WHERE id = 2</code>, MySQL elimina només aquesta fila i manté la 1 i la 3.';

          row2.className = 'row-deleted';
          stRow2.className = 'st-del';
          stRow2.textContent = 'Esborrada!';
        } else {
          issetBadge.textContent = 'FALSE (No existeix)';
          issetBadge.className = 'result-badge warn';
          issetDesc.innerHTML = 'Algú ha obert el fitxer sense <code>?id=...</code>. <code>isset()</code> retorna fals, evita un error de PHP i se salta el bloc <code>if</code>.';

          boxSql.classList.add('skipped');
          sqlPreview.textContent = '-- No s\'executa cap consulta DELETE --';
          sqlDesc.innerHTML = 'La base de dades queda intacta i no salta cap avís <code>Undefined array key "id"</code>.';

          row2.className = '';
          stRow2.className = 'st-keep';
          stRow2.textContent = 'Es manté';
        }
      });
    });
  }

  initEsborrarSim();
  document.addEventListener('astro:after-swap', initEsborrarSim);
</script>

<style>
  .del-widget,
  .del-widget * {
    box-sizing: border-box;
  }

  .del-widget {
    margin: 1.5rem 0;
    padding: 1.5rem;
    border-radius: 12px;
    background: #0f172a;
    border: 1px solid #334155;
    color: #f8fafc;
    max-width: 100%;
    overflow: hidden;
  }

  .widget-header {
    margin-bottom: 1.15rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0f172a;
    background: #facc15;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    margin-bottom: 0.4rem;
  }

  .widget-header h4 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    color: #f8fafc;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .widget-header h4 code {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.35);
    font-size: 0.95rem;
  }

  .guide {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #cbd5e1;
  }

  .guide code {
    background: rgba(30, 41, 59, 0.9);
    color: #facc15;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.84rem;
  }

  .sim-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 1rem;
  }

  @media (max-width: 820px) {
    .sim-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .panel {
    min-width: 0;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .panel-head {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #38bdf8;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.4rem;
  }

  .panel-head.mt-small {
    margin-top: 0.4rem;
  }

  .panel-head code {
    background: transparent;
    color: #facc15;
    text-transform: none;
  }

  .btn-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .req-btn {
    text-align: left;
    background: #0f172a;
    border: 2px solid #334155;
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: border-color 0.2s, background 0.2s;
  }

  .req-btn:hover {
    border-color: #64748b;
  }

  .req-btn.active {
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
  }

  .req-btn code {
    font-family: monospace;
    font-size: 0.82rem;
    color: #f8fafc;
    background: transparent;
    word-break: break-all;
  }

  .tag-ok,
  .tag-warn {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
  }

  .tag-ok {
    background: rgba(34, 197, 94, 0.2);
    color: #86efac;
  }

  .tag-warn {
    background: rgba(250, 204, 21, 0.2);
    color: #facc15;
  }

  .mini-db {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    background: #0f172a;
    border-radius: 8px;
    overflow: hidden;
  }

  .mini-db th {
    background: #020617;
    color: #94a3b8;
    text-align: left;
    padding: 0.45rem 0.6rem;
    font-size: 0.75rem;
  }

  .mini-db td {
    padding: 0.45rem 0.6rem;
    border-top: 1px solid #1e293b;
    color: #e2e8f0;
  }

  .mini-db code {
    color: #38bdf8;
    background: transparent;
    font-weight: 700;
  }

  .row-deleted {
    background: rgba(239, 68, 68, 0.12);
    text-decoration: line-through;
    opacity: 0.75;
  }

  .st-keep {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .st-del {
    font-size: 0.72rem;
    font-weight: 700;
    color: #fca5a5;
  }

  .logic-card {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.7rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: opacity 0.2s;
  }

  .logic-card.skipped {
    opacity: 0.45;
  }

  .logic-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .step-num {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #facc15;
  }

  .step-num code {
    background: transparent;
    color: #38bdf8;
    text-transform: none;
  }

  .result-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .result-badge.ok {
    background: rgba(34, 197, 94, 0.2);
    color: #86efac;
  }

  .result-badge.warn {
    background: rgba(250, 204, 21, 0.2);
    color: #facc15;
  }

  .logic-desc {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: #cbd5e1;
  }

  .logic-desc code {
    background: rgba(30, 41, 59, 0.9);
    color: #facc15;
    padding: 0.08rem 0.3rem;
    border-radius: 4px;
    font-size: 0.78rem;
  }

  .sql-preview,
  .hdr-preview {
    background: #020617;
    padding: 0.45rem 0.65rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.8rem;
    color: #4ade80;
    overflow-x: auto;
  }

  .hdr-preview {
    color: #7dd3fc;
  }
</style>